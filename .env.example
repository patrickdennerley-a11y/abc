# Google Gemini API Key (get from aistudio.google.com)
GEMINI_API_KEY=your_key_here

# Discord Webhook URL (from channel settings > integrations > webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optional: Google Alerts RSS URLs (comma-separated)
GOOGLE_ALERTS_RSS=https://google.com/alerts/feeds/xxx,https://google.com/alerts/feeds/yyy
